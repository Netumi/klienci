generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String
  status    String   @default("Wysłane")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
