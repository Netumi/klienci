generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Client {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  status    String   @default("Wysłane")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  tpayId    String   @unique
  status    String   @default("PENDING")
  amount    Float
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
